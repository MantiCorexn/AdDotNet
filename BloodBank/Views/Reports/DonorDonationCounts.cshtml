@model List<BloodBank.Models.DonorCountViewModel>

<h2>Donor Donation Counts</h2>

<table border="1">
    <tr>
        <th>Full Name</th>
        <th>Total Donations</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.DonationCount</td>
        </tr>
    }
</table>

<br />
<a asp-controller="Donor" asp-action="Index">Back to Donors</a>