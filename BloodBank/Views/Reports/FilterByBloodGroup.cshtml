@model List<BloodBank.Models.Donor>

<h2>Filter Donors by Blood Group</h2>

<form method="get" action="/Reports/FilterByBloodGroup">
    <label>Blood Group:</label>
    <input type="text" name="bloodGroup" value="@ViewData["SelectedGroup"]" placeholder="e.g. AB+" />
    <button type="submit">Filter</button>
</form>

<br />

@if (Model.Count == 0)
{
    <p>No donors found. Try entering a blood group above.</p>
}
else
{
    <table border="1">
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact</th>
            <th>City</th>
        </tr>
        @foreach (var donor in Model)
        {
            <tr>
                <td>@donor.FullName</td>
                <td>@donor.BloodGroup</td>
                <td>@donor.ContactNo</td>
                <td>@donor.City</td>
            </tr>
        }
    </table>
}

<br />
<a href="/Donor">Back to Donors</a>