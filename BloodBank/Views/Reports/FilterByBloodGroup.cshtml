@model List<BloodBank.Models.Donor>

<h2>Filter Donors by Blood Group</h2>

<form asp-action="FilterByBloodGroup" method="get" class="d-flex gap-2" style="max-width: 360px">
    <select name="bloodGroup" class="form-select"
            asp-items="@(new SelectList(BloodGroups.All, ViewData["SelectedGroup"] as string))">
        <option value="">-- Select --</option>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
</form>

<br />

@if (Model.Count == 0)
{
    <p>No donors found. Try entering a blood group above.</p>
}
else
{
    <table border="1">
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact</th>
            <th>City</th>
        </tr>
        @foreach (var donor in Model)
        {
            <tr>
                <td>@donor.FullName</td>
                <td>@donor.BloodGroup</td>
                <td>@donor.ContactNo</td>
                <td>@donor.City</td>
            </tr>
        }
    </table>
}

<br />
<a asp-controller="Donor" asp-action="Index">Back to Donors</a>