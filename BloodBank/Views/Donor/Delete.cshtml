@model BloodBank.Models.Donor
@{
    ViewData["Title"] = "Delete Donor";
}

<h2>Delete Donor</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<p>Are you sure you want to delete this donor?</p>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BloodGroup)</dt>
    <dd class="col-sm-9">@Model.BloodGroup</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.City)</dt>
    <dd class="col-sm-9">@Model.City</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.DonorId" method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
