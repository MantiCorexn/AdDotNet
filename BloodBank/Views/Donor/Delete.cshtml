@model BloodBank.Models.Donor

<h2>Delete Donor</h2>

<p>Are you sure you want to delete this donor?</p>

<p><strong>Name:</strong> @Model.FullName</p>
<p><strong>Blood Group:</strong> @Model.BloodGroup</p>
<p><strong>City:</strong> @Model.City</p>

<form method="post" action="/Donor/Delete/@Model.DonorId">
    <button type="submit">Confirm Delete</button>
</form>

<a href="/Donor">Cancel</a>