@model BloodBank.Models.Donor

<h2>Edit Donor</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div style="color:red">
        <ul>
            @foreach (var state in ViewData.ModelState.Values)
            {
                foreach (var error in state.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

<form method="post" action="/Donor/Edit/@Model.DonorId">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />

    <label>Full Name:</label><br />
    <input type="text" name="FullName" value="@Model.FullName" /><br /><br />

    <label>Blood Group:</label><br />
    <input type="text" name="BloodGroup" value="@Model.BloodGroup" /><br /><br />

    <label>Contact No:</label><br />
    <input type="text" name="ContactNo" value="@Model.ContactNo" /><br /><br />

    <label>City:</label><br />
    <input type="text" name="City" value="@Model.City" /><br /><br />

    <label>Last Donation Date:</label><br />
    <input type="date" name="LastDonationDate" value="@Model.LastDonationDate" /><br /><br />

    <button type="submit">Save</button>
</form>