@model BloodBank.Models.Donor
@{
    ViewData["Title"] = "Add Donor";
}

<h2>Add Donor</h2>

<form asp-action="Create" method="post" style="max-width: 480px">
    <partial name="_DonorForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
